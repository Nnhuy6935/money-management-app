# PostgreSQL / Supabase connection string
#
# Supabase Dashboard → Project Settings → Database → Connection string
#
# - App runtime (NestJS): dùng Connection pooling (port 6543) OK
# - drizzle-kit migrate: nên dùng Direct connection (port 5432)
#   vì pooler transaction mode thường lỗi với migrations
#
# Format: postgresql://USER:PASSWORD@HOST:PORT/postgres
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# JWT — đổi secret khi deploy production
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
