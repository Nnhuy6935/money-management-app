# =============================================================================
# Template biến môi trường — KHÔNG điền secret thật vào file này.
#
# Development (local):
#   cp .env.example .env.development      # rồi điền giá trị DB/R2 của dev
#   npm run start:dev
#
# Production:
#   Ưu tiên set biến môi trường trực tiếp trên server / CI / hosting.
#   Hoặc tạo .env.production trên server (không commit):
#   cp .env.example .env.production
#   npm run build && npm run start:prod
#
# Thứ tự nạp (cao → thấp): biến hệ thống > .env.<NODE_ENV>.local
#   > .env.<NODE_ENV> > .env (file .env chỉ được đọc ở development)
# =============================================================================

# -----------------------------------------------------------------------------
# App
# - NODE_ENV: development | production (script start:* đã tự set, không cần điền)
# - SWAGGER_ENABLED: mặc định bật ở development, tắt ở production
# -----------------------------------------------------------------------------
PORT=3000
# SWAGGER_ENABLED=true

# -----------------------------------------------------------------------------
# DATABASE_URL (Supabase)
# 1. Vào https://supabase.com/dashboard → chọn project
# 2. Project Settings → Database
# 3. Connection string → URI
# 4. Chọn "Session pooler" hoặc "Transaction" (port 6543) cho app runtime
#    (Migrate: nên dùng Direct connection port 5432 nếu pooler lỗi)
# 5. Thay [YOUR-PASSWORD] bằng Database password (Settings → Database → Database password)
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# -----------------------------------------------------------------------------
# JWT
# - JWT_SECRET: chuỗi ngẫu nhiên dài (đừng commit). Tạo nhanh:
#     openssl rand -base64 32
#   Production bắt buộc >= 32 ký tự và KHÁC secret của development.
# - JWT_EXPIRES_IN: thời hạn access token (vd 7d, 1h, 15m)
# -----------------------------------------------------------------------------
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# -----------------------------------------------------------------------------
# Cloudflare R2 — bắt buộc ở production. Nên dùng bucket riêng cho dev/prod.
# Xem README mục "Cấu hình biến môi trường" để lấy từng giá trị
# -----------------------------------------------------------------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=moneytalk
R2_PUBLIC_URL=
# Optional (mặc định = https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com)
# R2_ENDPOINT=
